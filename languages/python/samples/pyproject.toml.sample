# pyproject.toml — complete Python project configuration
#
# This sample shows the full pyproject.toml for a Python project:
# build system, metadata, dependencies, and tool configuration.
# Copy this file, rename it to pyproject.toml, and adjust the values.


# === Build system ===

[build-system]
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"


# === Project metadata ===

[project]
name = "your-project"
dynamic = ["version"]
description = "One-line description of what this project does."
readme = "README.md"
license = "MIT"
license-files = ["LICENSE.md"]
# Authorship — use your judgement. Three common cases:
#
# Organization only (no single point of contact):
#   authors = [{ name = "Your Organization" }]
#
# Single principal author (the person who can answer questions):
#   authors = [{ name = "Your Name", email = "you@example.com" }]
#
# Team (multiple contributors, all reachable):
#   authors = [
#       { name = "Alice", email = "alice@example.com" },
#       { name = "Bob", email = "bob@example.com" },
#   ]
#
# The README should make clear who to contact regardless of what you
# put here — this field is for tooling and package indices.
authors = [
    { name = "Your Name", email = "you@example.com" },
]
requires-python = ">=3.12"
dependencies = [
    "loguru",
    # Add your dependencies here.
]

[dependency-groups]
dev = [
    "prek",
    "pytest",
    "pytest-cov",
    "ruff",
    "ty",
]


# === Hatch (build and versioning) ===

[tool.hatch.version]
source = "vcs"
# Version is a pure function of git history; working-tree dirtiness is ignored.
# See STANDARDS.md § Versioning and Releases.
raw-options = { local_scheme = "no-local-version", git_describe_command = ["git", "describe", "--tags", "--long", "--match", "*[0-9]*"] }

[tool.hatch.build.hooks.vcs]
version-file = "src/your_project/_version.py"

[tool.hatch.build.targets.wheel]
packages = ["src/your_project"]


# === ruff ===

[tool.ruff]
target-version = "py312"                # Adjust to your minimum supported Python
line-length = 120
extend-exclude = [
    "src/your_project/_version.py",     # Generated by hatch-vcs
]

[tool.ruff.lint]
select = [
    "D",    # pydocstyle — docstring conventions
    "E",    # pycodestyle — PEP 8 errors
    "F",    # pyflakes — unused imports, undefined names, etc.
    "I",    # isort — import sorting
    "W",    # pycodestyle — PEP 8 warnings
    "UP",   # pyupgrade — modernize syntax for target Python version
    "B",    # flake8-bugbear — common bugs and design problems
]
ignore = [
    "D203",   # Conflicts with D211 (no blank line before class docstring)
    "D212",   # Conflicts with D213 (multi-line summary on second line)
]
# preview = true                        # Optional: enable preview-stage rules

[tool.ruff.lint.per-file-ignores]
# Relax docstring requirements in tests:
# "tests/**" = ["D"]

[tool.ruff.lint.isort]
split-on-trailing-comma = true

[tool.ruff.format]
quote-style = "double"
# preview = true                        # Optional: enable preview-stage formatting


# === ty ===

[tool.ty.src]
exclude = [
    "hatch_build.py",                   # Build hook, if present
    "src/your_project/_version.py",     # Generated by hatch-vcs
]

# For pixi projects: tell ty where to find the Python environment.
# Uncomment and adjust the path for your pixi environment name.
# [tool.ty.environment]
# python = ".pixi/envs/dev/bin/python"


# === pytest ===

[tool.pytest.ini_options]
addopts = "--doctest-modules"
testpaths = ["tests", "src"]
markers = [
    "slow: too slow for the commit loop; deselected by the pre-commit hook, gates in CI",
]
# Measure coverage: uv run pytest --cov=your_project
